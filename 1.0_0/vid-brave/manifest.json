{
  "manifest_version": 3,
  "name": "Video Grabber & Speeder",
  "version": "1.0.0",
  "description": "Detect videos and audio on any page, download them, and control playback speed (0.25x - 16x).",
  "permissions": ["downloads", "activeTab", "storage", "scripting"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Video Grabber & Speeder"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}